<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GestionNotes</RootNamespace>
    <StartupObject>GestionNotes.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <AssemblyTitle>GestionNotes</AssemblyTitle>
    <Product>GestionNotes - UATM/GASA Formation</Product>
    <Description>Application de gestion des notes des etudiants</Description>
  </PropertyGroup>

</Project>
